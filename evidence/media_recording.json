  "sourceHTML_SHA256": "f0365d2549ea27169f94717dab10467560315ace86347e0c0bd5cb999108d021",
  "capture": "Real Chromium viewport recording; set_content loaded exact standalone HTML bytes. Editorial captions only. No metric mocks, physics speed changes or hidden control law.",
  "chapterCaptions": [
    {
      "start": 0.0,
      "text": "A trained example is running. Your own learner is still random."
    },
    {
      "start": 6.021,
      "text": "Move the target. The network commands the BAM drive—not the cart position."
    },
    {
      "start": 12.054,
      "text": "A real 4 N × 0.20 s push. Test exposure does not train the policy."
    },
    {
      "start": 17.225,
      "text": "English and Korean share one engine. Switching language keeps state."
    },
    {
      "start": 21.422,
      "text": "Freeze one recorded experience. Click a neuron and see its actual arithmetic."
    },
    {
      "start": 27.719,
      "text": "Products + bias → tanh. Changing an input is not the same as learning."
    },
    {
      "start": 30.783,
      "text": "Δw / Δh shows the saved minibatch update, not an animation of improvement."
    },
    {
      "start": 34.907,
      "text": "Reward scores the task. GAE estimates a learning signal—not the true future."
    },
    {
      "start": 39.073,
      "text": "Backpropagation: which weights contributed to this sample’s loss?"
    },
    {
      "start": 42.125,
      "text": "128 gradients are averaged. Adam uses their history to change each weight."
    },
    {
      "start": 46.29,
      "text": "Keep the input fixed. Read the actual action-probability change."
    },
    {
      "start": 49.376,
      "text": "Change a cost or physical condition—then choose where it applies."
    },
    {
      "start": 54.594,
      "text": "Now train a separate, random policy. Progress comes from real PPO updates."
    },
    {
      "start": 59.423,
      "text": "This short run is complete. Freeze the weights and test—do not infer success from loss."
    },
    {
      "start": 62.729,
      "text": "Held-out tests freeze this example policy. Count exposure and invalid-model stops."
    },
    {
      "start": 68.028,
      "text": "No hidden PID. No invented learning curve. One local lab, two languages."
    }
  ],
